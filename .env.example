# Copy this file, rename the copy to ".env", and paste your keys after the = sign.
# NEVER upload .env to GitHub.
#
# MODEL PLAN (all free):
#   - Bulk tagging + MVP  -> Gemini 3.5 Flash-Lite (free tier: ~500 requests/day, ~10/min)
#   - Small high-quality runs (golden set, theme naming) -> Gemini 3.5 Flash (3.7/3.8 Flash were overloaded with 503 errors on 6-7 Nov)
#   - Backup when Gemini hits a limit -> Groq
#   - Gemini 4 Argon is NOT free on the API; use it in the Gemini app (your AI Pro plan) for manual review only.
# Check your exact limits at: Google AI Studio -> Dashboard -> Rate limits

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_QUALITY_MODEL=gemini-3.5-flash

GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

YOUTUBE_API_KEY=

REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=sip-research-script/0.1
